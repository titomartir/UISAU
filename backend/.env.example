# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================
# BASE DE DATOS PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uisau_db
DB_USER=postgres
DB_PASSWORD=__SET_DB_PASSWORD__

# ============================================
# JWT - CAMBIAR ESTOS VALORES EN PRODUCCIÓN
# ============================================
JWT_SECRET=__SET_STRONG_JWT_SECRET__
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__SET_STRONG_REFRESH_SECRET__
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# ENCRIPTACIÓN - DEBE SER EXACTAMENTE 32 CHARS
# ============================================
ENCRYPTION_KEY=__SET_32_CHAR_ENCRYPTION_KEY__

# ============================================
# ADMIN INICIAL (usado en el seeder)
# ============================================
ADMIN_EMAIL=__SET_ADMIN_EMAIL__
ADMIN_PASSWORD=__SET_ADMIN_PASSWORD__
