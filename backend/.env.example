# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================
# BASE DE DATOS PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=encuestas_satisfaccion
DB_USER=postgres
DB_PASSWORD=__REDACTED_DB_PASSWORD__

# ============================================
# JWT - CAMBIAR ESTOS VALORES EN PRODUCCIÓN
# ============================================
JWT_SECRET=__REDACTED_JWT_SECRET__
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__REDACTED_JWT_REFRESH_SECRET__
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# ENCRIPTACIÓN - DEBE SER EXACTAMENTE 32 CHARS
# ============================================
ENCRYPTION_KEY=__REDACTED_ENCRYPTION_KEY_32CH__

# ============================================
# ADMIN INICIAL (usado en el seeder)
# ============================================
ADMIN_EMAIL=ADMIN_EMAIL_REDACTED@example.invalid
ADMIN_PASSWORD=__REDACTED_ADMIN_PASSWORD__
