# UISAU production environment example
# Copy to .env.production and replace all CHANGE_ME values before running production compose.

POSTGRES_DB=uisau_db
POSTGRES_USER=uisau_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

DB_HOST=postgres
DB_PORT=5432
DB_NAME=uisau_db
DB_USER=uisau_app
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

PORT=5000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=http://localhost:13000

JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

VITE_BACKEND_URL=http://localhost:15000